# ── Ambiente ────────────────────────────────────────────────
APP_ENV=development            # development | staging | production
APP_URL=http://localhost:3000

# ── Banco ───────────────────────────────────────────────────
# Aplicação: SEMPRE pelo pooler em modo transação, com o role restrito pa_app.
#   Local: pgbouncer do docker compose (porta 6432).
#   Supabase: porta 6543 do pooler, usuário pa_app.<project-ref>.
DATABASE_URL="postgresql://pa_app:pa_app@localhost:6432/pa_premios?pgbouncer=true&connection_limit=10"
# Migrations e tarefas longas: conexão direta, role dono do schema.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/pa_premios

# Testes de integração: servidor e credenciais. Cada execução cria e remove um banco descartável.
TEST_DATABASE_URL="postgresql://pa_app:pa_app@localhost:6432/pa_premios_test?pgbouncer=true&connection_limit=20"
TEST_DIRECT_URL=postgresql://postgres:postgres@localhost:5432/pa_premios_test
# Banco onde o pg_cron está instalado (cron.database_name).
PG_CRON_DIRECT_URL=postgresql://postgres:postgres@localhost:5432/pa_premios

# ── Redis (Upstash; local via serverless-redis-http) ───────
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local-dev-token

# ── Jobs ────────────────────────────────────────────────────
CRON_SECRET=troque-por-um-segredo-com-32-ou-mais-caracteres
