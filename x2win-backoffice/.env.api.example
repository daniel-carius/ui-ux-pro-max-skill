# Modo API do painel: login real e dados no servidor (pasta server/, porta 3333).
#
# Como usar (escolha um):
#   cp .env.api.example .env.api && npx vite --mode api        # só quando pedir o modo "api"
#   cp .env.api.example .env.local && npm run dev              # sempre em modo API
#   VITE_API_MODE=1 npx vite build                             # build de produção em modo API
#
# Sem VITE_API_MODE=1 o painel roda em modo demonstração (dados no navegador, sem login).
VITE_API_MODE=1

# Endereço da API quando ela não está na mesma origem do painel (opcional).
# Em desenvolvimento deixe comentado: o Vite encaminha /api para http://localhost:3333
# e o cookie de sessão (SameSite=Strict) fica na mesma origem.
# VITE_API_URL=https://api.exemplo.com.br
