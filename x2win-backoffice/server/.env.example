# Ambiente: development | test | production. Sem valor vale production (cookie Secure obrigatório e webhooks só
# para https público): esquecer a variável nunca afrouxa a segurança. "npm run dev" já usa development;
# "npm run seed" e "npm run migrate" usam development quando a variável não está definida.
NODE_ENV=development

# Porta e endereço da API
PORT=3333
HOST=0.0.0.0

# Banco de dados:
#   postgres://usuario:senha@host:5432/x2win  -> PostgreSQL (produção)
#   pglite://./data/pglite                      -> Postgres embutido em arquivo (desenvolvimento)
#   memory://                                   -> Postgres embutido em memória (testes)
DATABASE_URL=pglite://./data/pglite

# Segredo para assinar sessões e derivar chaves. Gere com: openssl rand -base64 48
APP_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
# Chave AES-256 (32 bytes em base64) para cifrar segredos e 2FA no banco. Gere com: openssl rand -base64 32
ENCRYPTION_KEY=

# Endereço do painel autorizado a chamar a API (CORS). Vazio = mesma origem.
CORS_ORIGIN=http://localhost:5173
# Cookie de sessão só por HTTPS. Em produção TEM de ser true (a API não sobe com false); sem valor: true em
# produção, false fora dela. false só no desenvolvimento local, em http://localhost.
COOKIE_SECURE=false
# Número de proxies confiáveis à frente da API (para ler o IP real em X-Forwarded-For). 0 = nenhum.
# Com TRUST_PROXY > 0 e COOKIE_SECURE=true, a API só atende o que o proxy diz ter chegado por HTTPS
# (X-Forwarded-Proto: https); o resto recebe 403 https_obrigatorio (senha e cookie nunca em texto claro).
# Atrás do nginx do deploy/ use 1: um valor maior deixaria o cliente forjar o próprio IP.
TRUST_PROXY=0

# Destinos de webhook em http e em rede interna (localhost, 10.x, 192.168.x...): só para testar um receptor local
# no desenvolvimento. NUNCA em produção (a API não sobe com NODE_ENV=production e true): abriria SSRF para a rede
# interna do servidor.
WEBHOOK_ALLOW_LOCAL_TARGETS=false

# Primeiro acesso: cria o Superadmin se ainda não existir nenhum usuário
ADMIN_NAME=Daniel Carius
ADMIN_EMAIL=daniel@x2win.bet.br
ADMIN_PASSWORD=

# Carrega dados de demonstração (saques, destinos de webhook, equipe de exemplo) no seed
DEMO_DATA=true

# Recuperação de acesso (break-glass), quando a lista de IPs do painel deixou todos de fora: defina um valor novo
# (ex.: PANEL_ALLOWLIST_RESET=incidente-2026-10-10) e reinicie a API. Na subida a lista é esvaziada uma vez por
# valor, com registro na auditoria; o login continua exigindo senha e 2FA. Depois retire a variável e refaça a
# lista pelo painel (subir de novo com o mesmo valor não mexe na lista).
# PANEL_ALLOWLIST_RESET=
