# Porta e endereço da API
PORT=3333
HOST=0.0.0.0

# Banco de dados:
#   postgres://usuario:senha@host:5432/x2win  -> PostgreSQL (produção)
#   pglite://./data/pglite                      -> Postgres embutido em arquivo (desenvolvimento)
#   memory://                                   -> Postgres embutido em memória (testes)
DATABASE_URL=pglite://./data/pglite

# Segredo para assinar sessões e derivar chaves. Gere com: openssl rand -base64 48
APP_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
# Chave AES-256 (32 bytes em base64) para cifrar segredos e 2FA no banco. Gere com: openssl rand -base64 32
ENCRYPTION_KEY=

# Endereço do painel autorizado a chamar a API (CORS). Vazio = mesma origem.
CORS_ORIGIN=http://localhost:5173
# Use true atrás de HTTPS (produção)
COOKIE_SECURE=false
# Número de proxies confiáveis à frente da API (para ler o IP real). 0 = nenhum.
TRUST_PROXY=0

# Primeiro acesso: cria o Superadmin se ainda não existir nenhum usuário
ADMIN_NAME=Daniel Carius
ADMIN_EMAIL=daniel@x2win.bet.br
ADMIN_PASSWORD=

# Carrega dados de demonstração (saques, destinos de webhook, equipe de exemplo) no seed
DEMO_DATA=true
