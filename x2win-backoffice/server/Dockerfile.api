# API do backoffice. Contexto de build: a pasta x2win-backoffice/
# (o servidor usa shared/ e os dados de demonstração de src/data/, com o que eles importam do painel:
# server/test/core-deploy.test.ts confere que o bundle não pede nenhum arquivo de src/ que não foi copiado).
FROM node:22-alpine AS build
WORKDIR /app
COPY server/package.json server/package-lock.json server/.npmrc ./server/
RUN cd server && npm ci
COPY shared ./shared
COPY src/data ./src/data
COPY src/domain/ggr.ts ./src/domain/ggr.ts
COPY src/lib/random.ts ./src/lib/random.ts
COPY server ./server
# dist/index.js (API), dist/seed.js e dist/migrate.js: migrações num passo à parte, com o usuário dono das tabelas
# (serviço "migrate" do compose); a API conecta com o papel x2win_app, que não tem DDL nem pode apagar a auditoria
RUN cd server && npm run build && npm prune --omit=dev

FROM node:22-alpine
ENV NODE_ENV=production
# pool de threads do libuv: scrypt das senhas, dns.lookup e arquivos. A fila das senhas (modules/auth/password-gate.ts)
# usa no máximo metade dele, então DNS do Postgres e a conferência anti-SSRF dos webhooks sempre têm thread livre
ENV UV_THREADPOOL_SIZE=16
WORKDIR /app
COPY --from=build /app/server/node_modules ./node_modules
COPY --from=build /app/server/dist ./dist
COPY --from=build /app/server/package.json ./package.json
USER node
EXPOSE 3333
# /api/health só responde 200 com o banco respondendo (select 1 em até 2 s); senão 503 e o contêiner fica unhealthy
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://127.0.0.1:3333/api/health || exit 1
CMD ["node", "dist/index.js"]
