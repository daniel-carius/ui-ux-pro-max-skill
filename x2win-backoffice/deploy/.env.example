# Copie para deploy/.env e preencha. Nunca versione o .env.
# Senhas do banco em hexadecimal (entram na URL de conexão): openssl rand -hex 32
# Dono das tabelas: só o serviço "migrate" usa (a API não recebe esta senha)
POSTGRES_PASSWORD=
# Usuário x2win_app, com que a API conecta (sem DDL; na auditoria só lê e inclui)
APP_DB_PASSWORD=
# openssl rand -base64 48
APP_SECRET=
# openssl rand -base64 32
ENCRYPTION_KEY=
# Painel e API no mesmo domínio (nginx): deixe vazio
CORS_ORIGIN=
# Obrigatório em produção: o nginx termina o HTTPS (certificado em deploy/certs/) e a API recusa subir sem isto.
# NODE_ENV=production e TRUST_PROXY=1 já vêm do Dockerfile.api e do docker-compose.yml: com eles a API só atende
# o que chegou ao nginx por HTTPS (senão 403 https_obrigatorio). Não defina WEBHOOK_ALLOW_LOCAL_TARGETS aqui.
COOKIE_SECURE=true
# Primeiro acesso
ADMIN_NAME=Daniel Carius
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEMO_DATA=false
# Recuperação de acesso (break-glass), se a lista de IPs do painel deixar todos de fora: descomente com um valor
# novo e recrie a API (docker compose --env-file deploy/.env up -d api). A lista é esvaziada uma vez por valor, com
# auditoria; depois comente de novo e refaça a lista pelo painel.
# PANEL_ALLOWLIST_RESET=incidente-AAAA-MM-DD
